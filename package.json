{
  "name": "dave-drums-metronome",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "The free Dave Drums React metronome, migrated from Practice Vault",
  "license": "MIT",
  "author": "Dave Drums",
  "repository": {
    "type": "git",
    "url": "https://github.com/dave-drums/metronome.git"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "build:embed": "vite build --config vite.embed.config.js",
    "build:pages": "npm run build && npm run build:embed && node scripts/package-pages.mjs && npm run test:embed-build",
    "build:reference": "vite build --config tests/fixtures/vite.config.js",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:embed-build": "node scripts/verify-build.mjs",
    "serve": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "workbox-window": "7.4.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "16.3.3",
    "jsdom": "30.1.3",
    "pixelmatch": "7.1.0",
    "pngjs": "7.0.0",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5",
    "workbox-build": "7.4.1"
  }
}
